## 数据模型

### 漫步记录（Walk）
```javascript
{
  id: string,
  name: string,              // 路径名称
  date: timestamp,
  duration: number,          // 秒
  distance: number,          // 米
  trackPoints: [
    { lat: number, lng: number, timestamp: number }
  ],
  colorNodes: [
    {
      id: string,
      lat: number,
      lng: number,
      timestamp: number,
      color: string,         // HEX
      name: string,
      photoId: string,
      trackPointIndex: number // 在 trackPoints 中的索引
    }
  ]
}
```

### 色彩点（ColorPoint）
```javascript
{
  id: string,
  lat: number,
  lng: number,
  color: string,             // HEX
  name: string,
  photoId: string,
  timestamp: number,
  walkId: string,            // 关联的漫步 ID
  description: string
}
```

### 照片（Photo）
```javascript
{
  id: string,
  blob: Blob,                // 压缩后的图片数据
  thumbnail: string,         // 缩略图 base64
  dominantColors: [string],  // 提取的 5 个主色
  timestamp: number,
  lat: number,
  lng: number,
  walkId: string,
  description: string
}
```

### 色卡（ColorCard）
```javascript
{
  id: string,
  hex: string,
  hsl: [h, s, l],
  name: string,
  photoId: string,
  timestamp: number,
  lat: number,
  lng: number,
  walkId: string
}
```

### 拼贴作品（Collage）
```javascript
{
  id: string,
  imageBlob: Blob,           // 合成后的图片
  templateId: string,
  photoIds: [string],
  colors: [string],
  timestamp: number,
  walkId: string
}
```

---

## Leaflet + OpenStreetMap 配置

### MapComponent.vue 的核心实现

```vue
<template>
  <div class="map-container">
    <div id="map" class="leaflet-map"></div>
  </div>
</template>

<script setup>
import { onMounted, ref, defineExpose } from 'vue'
import L from 'leaflet'
import { useMapStore } from '@/stores/mapStore'

const mapStore = useMapStore()
let map = null
let pathLayers = []
let colorPointLayers = []

onMounted(() => {
  // 初始化地图
  map = L.map('map').setView([27.8362, 121.1578], 15)

  // 添加 OpenStreetMap 底图（极简灰度风格）
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap contributors',
    maxZoom: 19,
    className: 'leaflet-tiles-grayscale'
  }).addTo(map)

  // 应用灰度滤镜
  applyGrayscaleFilter()

  // 渲染历史路径和色彩点
  renderAllPaths()
  renderAllColorPoints()

  // 监听地图点击事件
  map.on('click', handleMapClick)
})

// 应用灰度滤镜
function applyGrayscaleFilter() {
  const tiles = document.querySelector('.leaflet-tiles-grayscale')
  if (tiles) {
    tiles.style.filter = 'grayscale(100%) brightness(1.1)'
  }
}

// 渲染所有历史路径
function renderAllPaths() {
  pathLayers.forEach(layer => map.removeLayer(layer))
  pathLayers = []

  mapStore.allPaths.forEach(path => {
    const coordinates = path.trackPoints.map(p => [p.lat, p.lng])
    
    // 如果路径有色彩节点，使用渐变色
    if (path.colorNodes.length > 0) {
      renderGradientPath(coordinates, path.colorNodes)
    } else {
      // 否则使用灰色
      const polyline = L.polyline(coordinates, {
        color: '#CCCCCC',
        weight: 6,
        opacity: 0.6,
        dashArray: '5, 5',
        lineCap: 'round',
        lineJoin: 'round'
      }).addTo(map)
      pathLayers.push(polyline)
    }
  })
}

// 渲染渐变色路径
function renderGradientPath(coordinates, colorNodes) {
  colorNodes.forEach((node, index) => {
    const startIdx = index === 0 ? 0 : colorNodes[index - 1].trackPointIndex
    const endIdx = node.trackPointIndex
    
    const segmentCoords = coordinates.slice(startIdx, endIdx + 1)
    
    const polyline = L.polyline(segmentCoords, {
      color: node.color,
      weight: 8,
      opacity: 0.7,
      lineCap: 'round',
      lineJoin: 'round'
    }).addTo(map)
    
    pathLayers.push(polyline)
  })
}

// 渲染所有色彩点
function renderAllColorPoints() {
  colorPointLayers.forEach(layer => map.removeLayer(layer))
  colorPointLayers = []

  mapStore.allColorPoints.forEach(point => {
    const circle = L.circleMarker([point.lat, point.lng], {
      radius: 6,
      fillColor: point.color,
      color: '#FFFFFF',
      weight: 1.5,
      opacity: 1,
      fillOpacity: 0.9
    })
    
    circle.addTo(map)
    
    // 点击事件
    circle.on('click', () => {
      emit('colorPointClick', point)
    })
    
    colorPointLayers.push(circle)
  })
}

// 添加实时轨迹（行进中）
function addRealtimeTrack(coordinates) {
  if (pathLayers.length > 0) {
    map.removeLayer(pathLayers[pathLayers.length - 1])
  }
  
  const polyline = L.polyline(coordinates, {
    color: '#CCCCCC',
    weight: 4,
    opacity: 0.6,
    dashArray: '5, 5',
    lineCap: 'round'
  }).addTo(map)
  
  pathLayers.push(polyline)
}

// 添加色彩点（实时）
function addColorPoint(lat, lng, color) {
  const circle = L.circleMarker([lat, lng], {
    radius: 6,
    fillColor: color,
    color: '#FFFFFF',
    weight: 1.5,
    opacity: 1,
    fillOpacity: 0.9
  }).addTo(map)
  
  colorPointLayers.push(circle)
}

// 导出方法供父组件调用
defineExpose({
  addRealtimeTrack,
  addColorPoint,
  renderAllPaths,
  renderAllColorPoints,
  map
})
</script>

<style scoped>
.map-container {
  width: 100%;
  height: 100%;
  position: relative;
}

#map {
  width: 100%;
  height: 100%;
}
</style>
```

